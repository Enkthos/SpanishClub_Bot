# Токен от @BotFather
BOT_TOKEN=123456:replace-me

# Ваш Telegram ID (исполнитель). Узнать: напишите боту /id
ADMIN_ID=0

# ID приватной супергруппы с включёнными темами (начинается с -100). Узнать: /id в группе
ADMIN_GROUP_ID=-1000000000000

# Реквизиты для перевода по номеру телефона
PAYMENT_PHONE=+7 900 000-00-00
PAYMENT_BANK=Т-Банк
PAYMENT_RECIPIENT=Иван И.

# БД (по умолчанию SQLite в ./data)
DB_URL=sqlite+aiosqlite:///data/bot.db

# Redis для хранения незаконченных анкет (на проде). Пусто — хранение в памяти
REDIS_URL=

TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
