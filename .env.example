TELEGRAM_BOT_TOKEN=your_botfather_token
# Comma-separated Telegram user IDs. Use /myid to find an ID.
ADMIN_TELEGRAM_IDS=
BOT_DATA_FILE=./data/game-state.json
# Code required when a player deletes their character.
CHARACTER_RESET_CODE=0000
# The dashboard is bound to localhost by default. Reach it through an SSH tunnel.
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3100
# Use a long random value; the dashboard does not start without it.
DASHBOARD_PASSWORD=change-this-to-a-long-random-password
